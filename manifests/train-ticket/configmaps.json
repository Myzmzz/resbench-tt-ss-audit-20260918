  {
   "apiVersion": "v1",
   "data": {
    "create-peers.sh": "#!/bin/sh\nset -eu\ni=0\nwhile [ $i -lt 3 ]\ndo\n  if [ $i = 0 ]\n  then\n    echo -n \"nacosdb-mysql-${i}.nacosdb-mysql.train-ticket:8801\"\n  else\n    echo -n \",nacosdb-mysql-${i}.nacosdb-mysql.train-ticket:8801\"\n  fi\n  i=$((i+1))\ndone\n",
    "leader-start.sh": "#!/usr/bin/env bash\ncurl -X PATCH -H \"Authorization: Bearer $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\" -H \"Content-Type: application/json-patch+json\" \\\n--cacert /var/run/secrets/kubernetes.io/serviceaccount/ca.crt https://$KUBERNETES_SERVICE_HOST:$KUBERNETES_PORT_443_TCP_PORT/api/v1/namespaces/train-ticket/pods/$HOSTNAME \\\n-d '[{\"op\": \"replace\", \"path\": \"/metadata/labels/role\", \"value\": \"leader\"}]'\n",
    "leader-stop.sh": "#!/usr/bin/env bash\ncurl -X PATCH -H \"Authorization: Bearer $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\" -H \"Content-Type: application/json-patch+json\" \\\n--cacert /var/run/secrets/kubernetes.io/serviceaccount/ca.crt https://$KUBERNETES_SERVICE_HOST:$KUBERNETES_PORT_443_TCP_PORT/api/v1/namespaces/train-ticket/pods/$HOSTNAME \\\n-d '[{\"op\": \"replace\", \"path\": \"/metadata/labels/role\", \"value\": \"follower\"}]'\n",
    "node.cnf": "[mysqld]\ndefault_storage_engine=InnoDB\nmax_connections=65535\n",
    "server-id.cnf": "[mysqld]\nserver-id=@@SERVER_ID@@\n"
   },
